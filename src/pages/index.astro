---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { SITE } from "../consts";
import { getPosts } from "../lib/posts";
import { withBase } from "../lib/site";

const posts = (await getPosts()).slice(0, 5);
---
<Base>
  <section class="hero wrap">
    <p class="eyebrow">{SITE.series}</p>
    <h1>Serious tech. Curious minds. Occasionally ridiculous ideas.</h1>
    <p class="lede">
      I'm {SITE.author}, a Data &amp; AI architect. Here I take real open data, build something with it, and explain
      the question, the choices and the result step by step.
    </p>
  </section>
  <section class="wrap">
    <h2>Latest</h2>
    {posts.map((post) => <PostCard post={post} />)}
    <p><a href={withBase("/blog/")}>All posts →</a></p>
  </section>
</Base>

<style>
  .hero { padding: 4rem 16px 1rem; }
  .lede { font-size: 1.2rem; color: var(--muted); }
</style>
