---
interface Props { checks: { check: string; value: string; passed: boolean }[] }
const { checks } = Astro.props;
---
<ul class="checks">
  {checks.map((c) => <li class={c.passed ? "ok" : "fail"}><span aria-hidden="true">{c.passed ? "✓" : "✗"}</span> {c.check}: <strong>{c.value}</strong></li>)}
</ul>

<style>
  .checks { list-style: none; padding: 0; }
  li { padding: 0.25rem 0; }
  .ok span { color: #1f8a5b; font-weight: 800; }
  .fail span { color: var(--coral-deep); font-weight: 800; }
</style>
